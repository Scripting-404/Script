local KLblObj, KPLblObj, PredLblObj

-- Kyst Killer
local KKRun=false
local function StartKK()
    if KKRun then return end; KKRun=true
    task.spawn(function()
        while VD.VIS_KystKiller and KKRun and not VD.Destroyed do
            local pl=Players:GetPlayers()
            table.sort(pl,function(a,b)
                local aA,bB=a:GetAttribute("AllowKiller") or false,b:GetAttribute("AllowKiller") or false
                if aA~=bB then return aA==true end
                return (a:GetAttribute("KillerChance") or 0)>(b:GetAttribute("KillerChance") or 0)
            end)
            local nk=pl[1]
            if KLblObj then pcall(function()
                KLblObj:SetContent("Kyst Killer: "..(nk and (nk==LocalPlayer and "YOU" or (nk.DisplayName or nk.Name)) or "None"))
            end) end
            task.wait(2)
        end
    end)
end
local function StopKK()
    KKRun=false
    if KLblObj then pcall(function() KLblObj:SetContent("Kyst Killer: Off") end) end
end

