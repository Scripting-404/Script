-- Killer Perks
local KPRun=false
local KYS_PerkNames={ KystInLine="Kyst in Line",["Kyst in Line"]="Kyst in Line",EchoLocation="Echo Location",["Echo Location"]="Echo Location",KingsScourge="King's Scourge",KingScourge="King's Scourge",["King's Scourge"]="King's Scourge" }
local function FmtPerk(n)
    n=tostring(n or "")
    if KYS_PerkNames[n] then return KYS_PerkNames[n] end
    local cl=n:gsub("_"," "):gsub("-"," "):gsub("(%l)(%u)","%1 %2"):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
    return cl~="" and cl or "Unknown Perk"
end
local function GetKP()
    for _,p in ipairs(Players:GetPlayers()) do
        local n=p.Team and p.Team.Name
        if n and n:lower():find("killer") then return p end
    end
end
local function ReadPerks(k)
    if not k then return {} end
    local c=k.Character or Workspace:FindFirstChild(k.Name); if not c then return {} end
    local res,seen={},{}
    local function add(r,d,l)
        if not r then return end
        r=tostring(r)
        if r=="" or r=="nil" or r:lower():find("template") or seen[r] then return end
        seen[r]=true
        table.insert(res,{Name=d and tostring(d) or FmtPerk(r),Level=l})
    end
    for _,ch in ipairs(c:GetChildren()) do
        local nm,lv=ch.Name:match("^(.+)%s+(%d+)$")
        if nm and nm~="" and not nm:lower():find("^(head|torso|humanoid|left|right)") then add(ch.Name,nm,lv) end
    end
    for _,inst in ipairs(c:GetDescendants()) do
        local ln=inst.Name:lower()
        if ln=="perks" or ln=="killerperks" or ln:find("perk") then
            if inst:IsA("StringValue") then add(inst.Value)
            elseif inst:IsA("BoolValue") and inst.Value then add(inst.Name) end
        end
    end
    return res
end
local function BuildKPText()
    local k=GetKP(); local kn=k and (k.DisplayName or k.Name) or "Unknown"
    local p=ReadPerks(k)
    if #p==0 then
        for _,pl in ipairs(Players:GetPlayers()) do
            local cp=ReadPerks(pl)
            if #cp>0 then k,kn,p=pl,pl.DisplayName or pl.Name,cp; break end
        end
    end
    local lines={"Killer Perks ["..kn.."]"}
    if #p==0 then table.insert(lines,"- Waiting for data...")
    else for i=1,math.min(#p,4) do
        table.insert(lines,"- "..p[i].Name..(p[i].Level and (" lvl "..p[i].Level) or ""))
    end end
    return table.concat(lines,"\n")
end
local function StartKP()
    if KPRun then return end; KPRun=true
    task.spawn(function()
        while VD.VIS_KillerPerks and KPRun and not VD.Destroyed do
            if KPLblObj then pcall(function() KPLblObj:SetContent(BuildKPText()) end) end
            task.wait(1)
        end
    end)
end
local function StopKP()
    KPRun=false
    if KPLblObj then pcall(function() KPLblObj:SetContent("Killer Perks: Off") end) end
end

-- Hide Survivor Icon
local HSI={Conn=nil, Orig={}}
local function GetSlots()
    local sl={}; local pg=LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return sl end
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Name:match("%-mob$") then
            local fr=g:FindFirstChild("Frame")
            if fr then for i=1,5 do
                local sf=fr:FindFirstChild("Survivor"..i)
                local il=sf and sf:FindFirstChild("ImageLabel")
                local tl=sf and sf:FindFirstChild("TextLabel")
                if (il and il:IsA("ImageLabel")) or (tl and tl:IsA("TextLabel")) then
                    table.insert(sl,{IL=il,TL=tl})
                end
            end end
        end
    end
    return sl
end
local function ApplyHSI()
    for _,s in ipairs(GetSlots()) do
        local il=s.IL
        if il and il:IsA("ImageLabel") then
            if not HSI.Orig[il] then HSI.Orig[il]={Image=il.Image,ImageColor3=il.ImageColor3,ImageTransparency=il.ImageTransparency,ImageRectOffset=il.ImageRectOffset,ImageRectSize=il.ImageRectSize,ScaleType=il.ScaleType} end
            il.Image="rbxassetid://80891639562743"; il.ImageColor3=Color3.fromRGB(255,255,255); il.ImageTransparency=0
            il.ImageRectOffset=Vector2.new(0,0); il.ImageRectSize=Vector2.new(0,0); il.ScaleType=Enum.ScaleType.Crop
        end
        local tl=s.TL
        if tl and tl:IsA("TextLabel") then
            if not HSI.Orig[tl] then HSI.Orig[tl]={Text=tl.Text,TextColor3=tl.TextColor3,TextTransparency=tl.TextTransparency} end
            tl.Text,tl.TextColor3,tl.TextTransparency="404",Color3.fromRGB(60,60,60),0
        end
    end
end
local function RestoreHSI()
    for obj,orig in pairs(HSI.Orig) do
        if obj and obj.Parent and orig then pcall(function()
            if orig.Image~=nil and obj:IsA("ImageLabel") then
                obj.Image,obj.ImageColor3,obj.ImageTransparency=orig.Image,orig.ImageColor3,orig.ImageTransparency
                obj.ImageRectOffset,obj.ImageRectSize,obj.ScaleType=orig.ImageRectOffset,orig.ImageRectSize,orig.ScaleType
            end
            if orig.Text~=nil and obj:IsA("TextLabel") then
                obj.Text,obj.TextColor3,obj.TextTransparency=orig.Text,orig.TextColor3,orig.TextTransparency
            end
        end) end
    end
    HSI.Orig={}
end
local function SetHSI(en)
    VD.VIS_HideSurvivorIcon=en and true or false
    if VD.VIS_HideSurvivorIcon then
        ApplyHSI()
        if not HSI.Conn then
            HSI.Conn=RunService.Heartbeat:Connect(function() if VD.VIS_HideSurvivorIcon then ApplyHSI() end end)
        end
    else
        if HSI.Conn then pcall(function() HSI.Conn:Disconnect() end); HSI.Conn=nil end
        RestoreHSI()
    end
end

-- Hook Counter
local HC={Conn=nil}
local function UpdHC(en)
    local pg=LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return end
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Name:match("%-mob$") then
            local fr=g:FindFirstChild("Frame")
            if fr then for i=1,5 do
                local sf=fr:FindFirstChild("Survivor"..i)
                local il=sf and sf:FindFirstChild("ImageLabel")
                local tl=sf and sf:FindFirstChild("TextLabel")
                if il and tl then
                    local ctr=il:FindFirstChild("Counter")
                    if ctr then pcall(function() ctr.Visible=en end) end
                    local cn="S404_HookCounter"
                    local cl=il:FindFirstChild(cn)
                    if en then
                        local pl
                        for _,p in ipairs(Players:GetPlayers()) do
                            if p.Name==tl.Text or p.DisplayName==tl.Text then pl=p; break end
                        end
                        local hc=0
                        if pl then hc=pl:GetAttribute("HookCount") or (pl.Character and pl.Character:GetAttribute("HookCount")) or 0 end
                        if not cl then
                            cl=Instance.new("TextLabel"); cl.Name=cn
                            cl.Size,cl.Position=UDim2.new(1,0,0.35,0),UDim2.new(0,0,0.65,0)
                            cl.BackgroundColor3,cl.BackgroundTransparency=Color3.new(0,0,0),0.5
                            cl.TextColor3,cl.TextStrokeColor3,cl.TextStrokeTransparency=Color3.fromRGB(255,255,255),Color3.new(0,0,0),0
                            cl.TextScaled,cl.Font=true,Enum.Font.SourceSansBold; cl.Parent=il
                        end
                        cl.Visible=true
                        if hc>=3 then cl.Text,cl.TextColor3="DEAD",Color3.fromRGB(255,75,75)
                        else cl.Text="Hooks: "..tostring(hc)
                            if hc==2 then cl.TextColor3=Color3.fromRGB(255,140,0)
                            elseif hc==1 then cl.TextColor3=Color3.fromRGB(255,215,0)
                            else cl.TextColor3=Color3.fromRGB(255,255,255) end
                        end
                    elseif cl then cl.Visible=false end
                end
            end end
        end
    end
end
local function SetHC(en)
    VD.VIS_ShowHookCounter=en and true or false
    if VD.VIS_ShowHookCounter then
        UpdHC(true)
        if not HC.Conn then HC.Conn=RunService.Heartbeat:Connect(function() if VD.VIS_ShowHookCounter then UpdHC(true) end end) end
    else
        if HC.Conn then pcall(function() HC.Conn:Disconnect() end); HC.Conn=nil end
        UpdHC(false)
        local pg=LocalPlayer:FindFirstChild("PlayerGui")
        if pg then for _,g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g.Name:match("%-mob$") then
                local fr=g:FindFirstChild("Frame")
                if fr then for i=1,5 do
                    local sf=fr:FindFirstChild("Survivor"..i)
                    local il=sf and sf:FindFirstChild("ImageLabel")
                    local cl=il and il:FindFirstChild("S404_HookCounter")
                    if cl then pcall(function() cl:Destroy() end) end
                end end
            end
        end end
    end
end

-- Ping & FPS
local PF={Gui=nil,Conn=nil,Frames=0,Last=tick()}
local function GetPing()
    local ok,v=pcall(function()
        local st=game:GetService("Stats"); local n=st and st:FindFirstChild("Network")
        local ss=n and n:FindFirstChild("ServerStatsItem"); local dp=ss and ss:FindFirstChild("Data Ping")
        if dp and dp.GetValue then return math.floor(dp:GetValue()+0.5) end
        if dp and dp.GetValueString then return tonumber(tostring(dp:GetValueString()):match("%d+")) end
    end)
    return ok and v or nil
end
local function SetPF(en)
    VD.VIS_ShowPingFPS=en and true or false
    if VD.VIS_ShowPingFPS then
        local parent=GetSafeGuiParent(); if not parent then return end
        if PF.Gui then pcall(function() PF.Gui:Destroy() end) end
        local sg=Instance.new("ScreenGui"); sg.Name="S404_PingFPS"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true; sg.Parent=parent
        local f=Instance.new("Frame"); f.Size=UDim2.new(0,118,0,44); f.Position=UDim2.new(0,12,0,120)
        f.BackgroundColor3=Color3.fromRGB(20,22,27); f.BackgroundTransparency=0.15; f.BorderSizePixel=0; f.Parent=sg
        Instance.new("UICorner",f).CornerRadius=UDim.new(0,8)
        local stk=Instance.new("UIStroke",f); stk.Color=Color3.fromRGB(80,120,220); stk.Thickness=1; stk.Transparency=0.4; stk.Parent=f
        local lbl=Instance.new("TextLabel",f); lbl.Name="PingFPSLabel"
        lbl.Size,lbl.Position=UDim2.new(1,-12,1,-8),UDim2.new(0,6,0,4)
        lbl.BackgroundTransparency=1
        lbl.Font,lbl.TextSize,lbl.TextColor3=Enum.Font.GothamBold,13,Color3.fromRGB(240,240,245)
        lbl.TextXAlignment,lbl.TextYAlignment=Enum.TextXAlignment.Left,Enum.TextYAlignment.Center
        lbl.Text="PING: --ms\nFPS: --"; lbl.Parent=f
        PF.Gui=sg; PF.Frames,PF.Last=0,tick()
        if not PF.Conn then
            PF.Conn=RunService.RenderStepped:Connect(function()
                if not VD.VIS_ShowPingFPS then return end
                PF.Frames=PF.Frames+1
                local now=tick()
                if now-PF.Last<0.5 then return end
                local fps=math.floor(PF.Frames/(now-PF.Last)+0.5)
                local p=GetPing()
                PF.Frames,PF.Last=0,now
                if PF.Gui then
                    local l=PF.Gui:FindFirstChild("PingFPSLabel",true)
                    if l then l.Text=("PING: %sms\nFPS: %d"):format(p and tostring(p) or "--",fps) end
                end
            end)
        end
    else
        if PF.Conn then pcall(function() PF.Conn:Disconnect() end); PF.Conn=nil end
        if PF.Gui then pcall(function() PF.Gui:Destroy() end); PF.Gui=nil end
    end
end

-- Predict Map
local PSt={Name="Unknown",Desc="Waiting...",Source="Idle",Phase="",TimeLeft=nil,LastNotif=nil}
local PConns={}
local PRun=false; local PredGui
local function MapStr(v)
    if type(v)=="string" then return v end
    if typeof and typeof(v)=="Instance" then return v.Name end
    if type(v)=="table" then return v.Title or v.title or v.Name or v.name or v.Map or v.map or v.MapName or v.mapName end
end
local function MapDesc(v)
    if type(v)~="table" then return nil end
    return v.Desc or v.desc or v.Description or v.description
end
local function SetPred(name,desc,src)
    name=MapStr(name) or name
    if not name or tostring(name)=="" then return end
    local old=PSt.Name
    PSt.Name=tostring(name)
    if desc and tostring(desc)~="" then PSt.Desc=tostring(desc) end
    PSt.Source=src or "Detected"
    if VD.VIS_PredictMap and PSt.Name~=old and PSt.Name~="Unknown" then
        if PSt.LastNotif~=PSt.Name then
            PSt.LastNotif=PSt.Name
            if VD.VIS_PredictMapMode=="Notify" then
                pcall(function()
                    Window:Notify({ Title="Predict Map", Content=PSt.Name..(PSt.Desc~="" and ("\n"..PSt.Desc) or ""), Duration=5, Icon="map" })
                end)
            end
        end
    end
    if PredGui then
        local l=PredGui:FindFirstChild("MapLabel",true)
        if l then l.Text="Map: "..PSt.Name.."\n"..PSt.Source end
    end
    if PredLblObj then pcall(function()
        PredLblObj:SetContent("Map: "..PSt.Name.."\nSource: "..PSt.Source..(PSt.Phase~="" and ("\nPhase: "..PSt.Phase..(PSt.TimeLeft and (" "..PSt.TimeLeft.."s") or "")) or ""))
    end) end
end
local function ReadMap()
    local m=Workspace:FindFirstChild("Map"); if not m then return nil end
    local cs=m:FindFirstChild("Camerascene1",true)
    if cs then
        local t=cs:GetAttribute("title"); local d=cs:GetAttribute("desc")
        if t then return tostring(t), d and tostring(d) or nil end
    end
    for _,c in ipairs(m:GetChildren()) do
        local t=c:GetAttribute("title") or c:GetAttribute("Title") or c:GetAttribute("MapName")
        if t then return tostring(t), c:GetAttribute("desc") or c:GetAttribute("Description") end
    end
    return m.Name~="Map" and m.Name or "Map Loaded", nil
end
local function TryRemote()
    local r=ReplicatedStorage:FindFirstChild("Remotes")
    local mc=r and r:FindFirstChild("Mechanics"); local ch=mc and mc:FindFirstChild("Chat")
    local gmd=ch and ch:FindFirstChild("GetMapData")
    if not (gmd and gmd:IsA("RemoteFunction")) then return false end
    for _,a in ipairs({{},{"Current"},{"Kyst"},{"Map"}}) do
        local ok,d=pcall(function() return gmd:InvokeServer(table.unpack(a)) end)
        if ok and d~=nil then
            local n,ds=MapStr(d),MapDesc(d)
            if n then SetPred(n,ds,"Predicted"); return true end
        end
    end
    return false
end
local function BindPredEvents()
    local r=ReplicatedStorage:FindFirstChild("Remotes"); if not r then return end
    local m=r:FindFirstChild("Messages"); local mi=m and m:FindFirstChild("Mapinfo")
    if mi and mi:IsA("RemoteEvent") then
        table.insert(PConns, mi.OnClientEvent:Connect(function(a,b,c)
            local n=MapStr(a) or MapStr(b) or MapStr(c)
            local ds=MapDesc(a) or MapDesc(b) or MapDesc(c)
            if n then SetPred(n,ds,"Predicted") end
        end))
    end
    local te=r:FindFirstChild("TimeUpdateEvent")
    if te and te:IsA("RemoteEvent") then
        table.insert(PConns, te.OnClientEvent:Connect(function(ph,tl)
            PSt.Phase=tostring(ph or ""); PSt.TimeLeft=tonumber(tl)
            if tostring(ph)=="Intermission" and tonumber(tl) and tonumber(tl)<=20 then pcall(TryRemote) end
        end))
    end
    table.insert(PConns, Workspace.ChildAdded:Connect(function(ch)
        if ch and ch.Name=="Map" then
            task.delay(0.25,function() local n,d=ReadMap(); if n then SetPred(n,d,"Confirmed") end end)
        end
    end))
end
local function MakePredGui()
    local parent=GetSafeGuiParent(); if not parent then return end
    if PredGui then pcall(function() PredGui:Destroy() end) end
    local sg=Instance.new("ScreenGui"); sg.Name="S404_PredictMap"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true; sg.Parent=parent
    local f=Instance.new("Frame"); f.Size=UDim2.new(0,220,0,62); f.Position=UDim2.new(0.02,0,0.18,0)
    f.BackgroundColor3=Color3.fromRGB(20,22,27); f.BackgroundTransparency=0.15; f.BorderSizePixel=0; f.Parent=sg
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,8)
    local stk=Instance.new("UIStroke",f); stk.Color=Color3.fromRGB(80,120,220); stk.Thickness=1; stk.Transparency=0.4; stk.Parent=f
    local l=Instance.new("TextLabel",f); l.Name="MapLabel"
    l.Size,l.Position=UDim2.new(1,-12,1,-8),UDim2.new(0,6,0,4)
    l.BackgroundTransparency=1
    l.Font,l.TextSize,l.TextColor3=Enum.Font.GothamBold,13,Color3.fromRGB(240,240,245)
    l.TextXAlignment,l.TextYAlignment=Enum.TextXAlignment.Left,Enum.TextYAlignment.Top
    l.TextWrapped=true; l.Text="Map: "..PSt.Name.."\n"..PSt.Source; l.Parent=f
    PredGui=sg
end
local function StopPredGui()
    if PredGui then pcall(function() PredGui:Destroy() end); PredGui=nil end
end
local function StartPred()
    if PRun then return end; PRun=true
    if VD.VIS_PredictMapMode=="GUI" then MakePredGui() end
    BindPredEvents()
    task.spawn(function()
        while VD.VIS_PredictMap and PRun and not VD.Destroyed do
            local n,d=ReadMap()
            if n then SetPred(n,d,"Confirmed") else pcall(TryRemote) end
            task.wait(1)
        end
    end)
end
local function StopPred()
    PRun=false
    for _,c in ipairs(PConns) do pcall(function() c:Disconnect() end) end
    PConns={}; StopPredGui(); PSt.LastNotif=nil
end

-- =================================================================
-- KILLER CORE
-- =================================================================
local function AutoAttack()
    if not VD.AUTO_Attack or GetRole()~="Killer" then return end
    local r=Root; if not r then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and IsSurvivor(p) and p.Character then
            local tR=p.Character:FindFirstChild("HumanoidRootPart")
            local tH=p.Character:FindFirstChildOfClass("Humanoid")
            if tR and tH and tH.MaxHealth>0 then
                if (tH.Health/tH.MaxHealth)>0.25 and (tR.Position-r.Position).Magnitude<=VD.AUTO_AttackRange then
                    pcall(function()
                        local rr=ReplicatedStorage:FindFirstChild("Remotes")
                        local aa=rr and rr:FindFirstChild("Attacks")
                        local ba=aa and aa:FindFirstChild("BasicAttack")
                        if ba then ba:FireServer(false) end
                    end)
                    break
                end
            end
        end
    end
end
local OrigHB={}
local function UpdHB()
    local function restore()
        for p,sz in pairs(OrigHB) do
            if p and p.Character then
                local r=p.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Size=sz; r.Transparency=1; r.CanCollide=true end
            end
        end
        OrigHB={}
    end
    if GetRole()~="Killer" or not VD.HITBOX_Enabled then restore(); return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and IsSurvivor(p) and p.Character then
            local r=p.Character:FindFirstChild("HumanoidRootPart")
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health>0 then
                if not OrigHB[p] then OrigHB[p]=r.Size end
                local sz=VD.HITBOX_Size
                r.Size=Vector3.new(sz,sz,sz); r.CanCollide=false; r.Transparency=0.7
            elseif r and OrigHB[p] then
                r.Size=OrigHB[p]; r.Transparency=1; r.CanCollide=true; OrigHB[p]=nil
            end
        end
    end
end
local OLunge
local function UpdLunge()
    local c=LocalPlayer.Character; if not c then return end
    if VD.KILLER_InfLunge then
        if c:GetAttribute("lungeboost")~=999999 then
            OLunge=c:GetAttribute("lungeboost") or 1
            c:SetAttribute("lungeboost",999999)
        end
    elseif OLunge then
        c:SetAttribute("lungeboost",OLunge); OLunge=nil
    end
end

