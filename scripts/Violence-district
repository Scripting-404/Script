local AbyssConn, CorruptFunc
local function StartAbyss()
    if not CorruptFunc then
        for _,v in pairs(getgc(true)) do
            if type(v)=="function" and islclosure(v) then
                local c=debug.getconstants(v)
                if table.find(c,"corrupt") and table.find(c,"Immobile") then CorruptFunc=v; break end
            end
        end
    end
    if not CorruptFunc then return end
    if AbyssConn then AbyssConn:Disconnect() end
    AbyssConn=RunService.Heartbeat:Connect(function()
        if not VD.KILLER_BypassCooldown then return end
        for i,v in pairs(debug.getupvalues(CorruptFunc)) do
            if type(v)=="boolean" and v==false then debug.setupvalue(CorruptFunc,i,true) end
        end
    end)
end
local function StopAbyss()
    if AbyssConn then AbyssConn:Disconnect(); AbyssConn=nil end
end

local JeffThread
local function StartJeff()
    if JeffThread then return end
    JeffThread=task.spawn(function()
        while task.wait() do
            if not VD.KILLER_InfFrenzy then break end
            pcall(function()
                local c=LocalPlayer.Character
                if c and c:GetAttribute("Frenzy")~=true then c:SetAttribute("Frenzy",true) end
            end)
        end
        JeffThread=nil
    end)
end
local function StopJeff()
    pcall(function()
        local c=LocalPlayer.Character
        if c and c:GetAttribute("Frenzy")==true then
            c:SetAttribute("Frenzy",false)
            local k=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Killers"):FindFirstChild("Killer")
            if k then local d=k:FindFirstChild("Deactivatefromclient"); if d then d:FireServer() end end
        end
    end)
end

local SlashThread
local function StartSlash()
    if SlashThread then return end
    pcall(function()
        local b=true; local mt=debug.getmetatable(b)
        if not mt then mt={}; debug.setmetatable(b,mt) end
        if setreadonly then setreadonly(mt,false) end
        mt.__div=function() return 0 end; mt.__mul=function() return 0 end
        mt.__add=function() return 0 end; mt.__sub=function() return 0 end
        if setreadonly then setreadonly(mt,true) end
    end)
    SlashThread=task.spawn(function()
        local tf,ph
        local function scan()
            pcall(function()
                for _,v in pairs(getgc(true)) do
                    if type(v)=="function" and islclosure(v) then
                        local cs=debug.getconstants(v)
                        local hO,hL,hA,hT,hP,hW=false,false,false,false,false,false
                        for _,c in pairs(cs) do
                            if c=="Offset" then hO=true end
                            if c=="Linear" then hL=true end
                            if c=="action" then hA=true end
                            if c=="TweenInfo" then hT=true end
                            if c=="Pursuit" then hP=true end
                            if c=="WalkSpeed" then hW=true end
                        end
                        if hO and hL and hA and hT and not hP then tf=v end
                        if hP and hT and hA and hW then ph=v end
                    end
                    if tf and ph then break end
                end
            end)
        end
        scan(); local last=os.clock()
        while task.wait(0.1) do
            if not VD.KILLER_InfLakeMist and not VD.KILLER_InfPursuit then break end
            if not (tf and ph) and os.clock()-last>=2 then scan(); last=os.clock() end
            if tf and VD.KILLER_InfLakeMist then pcall(function() debug.setupvalue(tf,6,false); debug.setupvalue(tf,10,false) end) end
            if ph and VD.KILLER_InfPursuit then pcall(function() debug.setupvalue(ph,5,false); debug.setupvalue(ph,6,false) end) end
        end
        SlashThread=nil
    end)
end
local function StopSlash()
    pcall(function()
        local j=ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Killers") and ReplicatedStorage.Remotes.Killers:FindFirstChild("Jason")
        if j then
            if not VD.KILLER_InfLakeMist then local lm=j:FindFirstChild("LakeMist"); if lm then lm:FireServer(false) end end
            if not VD.KILLER_InfPursuit then local ps=j:FindFirstChild("Pursuit"); if ps then ps:FireServer(false) end end
        end
    end)
end

local HiddenThread
local function StartHidden()
    if HiddenThread then return end
    HiddenThread=task.spawn(function()
        local lf,mf
        local function scan()
            pcall(function()
                for _,v in pairs(getgc(true)) do
                    if type(v)=="function" and islclosure(v) then
                        local info; pcall(function() info=debug.getinfo(v) end)
                        if info then
                            if info.name=="tryActivate" then lf=v
                            elseif info.name=="playM2Animation" then mf=v end
                        end
                    end
                    if lf and mf then break end
                end
            end)
        end
        scan(); local last=os.clock()
        while task.wait(0.1) do
            if not VD.KILLER_BypassLeap then break end
            if not (lf and mf) and os.clock()-last>=2 then scan(); last=os.clock() end
            if lf then pcall(function()
                for i,v in pairs(debug.getupvalues(lf)) do
                    if type(v)=="boolean" and v==true then debug.setupvalue(lf,i,false) end
                end
            end) end
            if mf then pcall(function()
                for i,v in pairs(debug.getupvalues(mf)) do
                    if type(v)=="boolean" and v==true then debug.setupvalue(mf,i,false) end
                end
            end) end
        end
        HiddenThread=nil
    end)
end
local function StopHidden() end

-- Myers Grab
MyersGrabData = { Enabled=false, Button=nil, Hotkey=Enum.KeyCode.H }
local function GetMT()
    local c=LocalPlayer.Character; if not c then return end
    local mr=c:FindFirstChild("HumanoidRootPart"); if not mr then return end
    local best,bd=nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            local hr=p.Character:FindFirstChild("HumanoidRootPart")
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if hr and h and h.Health>0 then
                local d=(hr.Position-mr.Position).Magnitude
                if d<bd then bd,best=d,p end
            end
        end
    end
    return best
end
local function DoGrab()
    if not MyersGrabData.Enabled then return end
    local t=GetMT(); if not t or not t.Character then return end
    pcall(function() ReplicatedStorage.Remotes.Killers.Stalker.grab:FireServer(t.Character) end)
end
local function SetupGrabBtn()
    if MyersGrabData.Button then pcall(function() MyersGrabData.Button.Parent:Destroy() end) end
    local pg=LocalPlayer:WaitForChild("PlayerGui")
    local sg=Instance.new("ScreenGui"); sg.Name="S404_MyersGrab"; sg.ResetOnSpawn=false; sg.IgnoreGuiInset=true; sg.Parent=pg
    local b=Instance.new("TextButton")
    b.Size,b.Position,b.AnchorPoint=UDim2.new(0,60,0,60),UDim2.new(0.7,0,0.75,0),Vector2.new(0.5,0.5)
    b.BackgroundColor3,b.BackgroundTransparency=Color3.fromRGB(20,22,27),0.15
    b.Text,b.TextColor3,b.TextSize,b.Font="GRAB",Color3.fromRGB(240,240,245),14,Enum.Font.GothamBold
    b.Visible=false; b.Parent=sg
    Instance.new("UICorner",b).CornerRadius=UDim.new(1,0)
    local s=Instance.new("UIStroke",b); s.Color,s.Thickness=Color3.fromRGB(80,120,220),2
    b.MouseButton1Click:Connect(DoGrab)
    MyersGrabData.Button=b
end
UserInputService.InputBegan:Connect(function(inp,gp)
    if gp then return end
    if inp.KeyCode==MyersGrabData.Hotkey and MyersGrabData.Enabled then DoGrab() end
end)

-- Fake Attack
local FakeThread
local function ToggleFakeAtk(en)
    if not en then
        if FakeThread then task.cancel(FakeThread); FakeThread=nil end
        return
    end
    if FakeThread then return end
    FakeThread=task.spawn(function()
        while VD.KILLER_FakeAttack do
            local c=LocalPlayer.Character
            if c then
                local an=c:FindFirstChild("Humanoid") and c.Humanoid:FindFirstChild("Animator")
                if an then
                    local mr=c:FindFirstChild("HumanoidRootPart")
                    local near=false
                    if mr then
                        for _,p in ipairs(Players:GetPlayers()) do
                            if p~=LocalPlayer and p.Team and p.Team.Name=="Survivors" then
                                local r=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                                if r and (mr.Position-r.Position).Magnitude<=15 then near=true; break end
                            end
                        end
                    end
                    if near then pcall(function()
                        local bait=Instance.new("Animation")
                        bait.AnimationId="rbxassetid://117042998468241"
                        local t=an:LoadAnimation(bait)
                        t:Play(); t:AdjustWeight(0)
                        task.wait(0.05); t:Stop()
                    end) end
                end
            end
            task.wait(0.3)
        end
        FakeThread=nil
    end)
end

-- Map cache
local Cache = { Generators={}, Gates={}, Hooks={}, Pallets={}, Windows={} }
local function ScanMap()
    local m=Workspace:FindFirstChild("Map")
    if not m then Cache.Generators,Cache.Gates,Cache.Hooks,Cache.Pallets,Cache.Windows={},{},{},{},{} return end
    local ng,nga,nh,np,nw={},{},{},{},{}
    for _,o in ipairs(m:GetDescendants()) do
        if o:IsA("Model") then
            local p=o:FindFirstChild("HitBox",true) or o:FindFirstChild("GeneratorPoint",true) or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart",true)
            if p then
                local n=o.Name
                if n=="Generator" then table.insert(ng,{model=o,part=p})
                elseif n=="Gate" or n=="ExitGate" then table.insert(nga,{model=o,part=p})
                elseif n=="Hook" then table.insert(nh,{model=o,part=p})
                elseif n=="Palletwrong" or n:lower():find("pallet") then table.insert(np,{model=o,part=p})
                elseif n=="Window" then table.insert(nw,{model=o,part=p}) end
            end
        elseif o:IsA("BasePart") then
            if o.Name=="VaultTrigger" then table.insert(nw,{model=o.Parent,part=o})
            elseif o.Name=="PalletPoint" or o.Name=="PalletPointSlide" then table.insert(np,{model=o.Parent,part=o}) end
        end
    end
    Cache.Generators,Cache.Gates,Cache.Hooks,Cache.Pallets,Cache.Windows=ng,nga,nh,np,nw
end
ScanMap()

-- Auto Hook
local function AutoHook()
    if not VD.KILLER_AutoHook or GetRole()~="Killer" then return end
    local r=Root; if not r then return end
    local c=LocalPlayer.Character
    local carry=c and (c:GetAttribute("IsCarrying") or c:GetAttribute("isCarrying"))
    if carry then
        local occ={}
        for _,v in ipairs(Players:GetPlayers()) do
            if v~=LocalPlayer and v.Character then
                local h=v.Character:GetAttribute("IsHooked") or v.Character:GetAttribute("isHooked")
                local hr=v.Character:FindFirstChild("HumanoidRootPart")
                if h and hr then table.insert(occ,hr.Position) end
            end
        end
        local ch,cd=nil,math.huge
        for _,h in ipairs(Cache.Hooks) do
            if h.part then
                local oc=false
                for _,op in ipairs(occ) do if (h.part.Position-op).Magnitude<10 then oc=true; break end end
                if not oc then
                    local d=(h.part.Position-r.Position).Magnitude
                    if d<cd then cd,ch=d,h end
                end
            end
        end
        if ch then
            task.spawn(function()
                r.CFrame=CFrame.new(ch.part.Position+Vector3.new(0,3,0)); task.wait(0.4)
                pcall(function()
                    local cf=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Carry")
                    local ev=cf and cf:FindFirstChild("HookEvent")
                    local cm=cf and cf:FindFirstChild("HookCommit")
                    local hp=ch.model:FindFirstChild("HookPoint") or ch.model:FindFirstChild("HookHitbox") or ch.part
                    if ev then ev:FireServer(hp) end
                    if cm then cm:FireServer(hp) end
                end)
            end)
        end
        return
    end
    local cdown,cdd=nil,math.huge
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and IsSurvivor(p) and p.Character then
            local tr=p.Character:FindFirstChild("HumanoidRootPart")
            local h=p.Character:FindFirstChildOfClass("Humanoid")
            if tr and h then
                local pct=(h.MaxHealth>0) and (h.Health/h.MaxHealth) or 0
                if pct<=0.25 and pct>0 then
                    local hooked=false
                    for _,hh in ipairs(Cache.Hooks) do
                        if hh.part and (hh.part.Position-tr.Position).Magnitude<4.5 then hooked=true; break end
                    end
                    if not hooked then
                        local d=(tr.Position-r.Position).Magnitude
                        if d<cdd then cdd,cdown=d,tr end
                    end
                end
            end
        end
    end
    if cdown then
        local occ={}
        for _,v in ipairs(Players:GetPlayers()) do
            if v~=LocalPlayer and v.Character then
                local h=v.Character:GetAttribute("IsHooked") or v.Character:GetAttribute("isHooked")
                local hr=v.Character:FindFirstChild("HumanoidRootPart")
                if h and hr then table.insert(occ,hr.Position) end
            end
        end
        local ch,cd=nil,math.huge
        for _,h in ipairs(Cache.Hooks) do
            if h.part then
                local oc=false
                for _,op in ipairs(occ) do if (h.part.Position-op).Magnitude<10 then oc=true; break end end
                if not oc then
                    local d=(h.part.Position-cdown.Position).Magnitude
                    if d<cd then cd,ch=d,h end
                end
            end
        end
        if ch then
            task.spawn(function()
                r.CFrame=CFrame.new(cdown.Position+Vector3.new(0,3,0),cdown.Position); task.wait(0.3)
                pcall(function()
                    local cf=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Carry")
                    local ce=cf and cf:FindFirstChild("CarrySurvivorEvent")
                    if ce then ce:FireServer(cdown.Parent) end
                end)
                task.wait(0.8)
                local mc=LocalPlayer.Character
                local carry2=mc and (mc:GetAttribute("IsCarrying") or mc:GetAttribute("isCarrying"))
                if carry2 then
                    r.CFrame=CFrame.new(ch.part.Position+Vector3.new(0,3,0)); task.wait(0.4)
                    pcall(function()
                        local cf=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Carry")
                        local ev=cf and cf:FindFirstChild("HookEvent")
                        local cm=cf and cf:FindFirstChild("HookCommit")
                        local hp=ch.model:FindFirstChild("HookPoint") or ch.model:FindFirstChild("HookHitbox") or ch.part
                        if ev then ev:FireServer(hp) end
                        if cm then cm:FireServer(hp) end
                    end)
                end
            end)
        end
    end
end

-- Destroy Pallets
local IBP=false
local function DestroyPallets()
    if not VD.KILLER_DestroyPallets or GetRole()~="Killer" or IBP then return end
    local c=LocalPlayer.Character; local r=Root
    if not c or not r then return end
    local st=c:GetAttribute("IsStunned") or c:GetAttribute("isStunned")
    local im=c:GetAttribute("Immobile") or c:GetAttribute("immobile")
    local cr=c:GetAttribute("IsCarrying") or c:GetAttribute("isCarrying")
    local pu=c:GetAttribute("Pursuit") or c:GetAttribute("pursuit")
    if st or im or cr or pu then return end
    local pts=CollectionService:GetTagged("PalletPointSlide")
    local nearest,md=nil,6
    for _,p in ipairs(pts) do
        if p:IsA("BasePart") and not CollectionService:HasTag(p,"doing action") then
            local d=(p.Position-r.Position).Magnitude
            if d<md then md,nearest=d,p end
        end
    end
    if nearest then
        IBP=true
        task.spawn(function()
            pcall(function()
                local rr=ReplicatedStorage:FindFirstChild("Remotes")
                local pp=rr and rr:FindFirstChild("Pallet")
                local j=pp and pp:FindFirstChild("Jason")
                if j then
                    local dg=j:FindFirstChild("Destroy-Global")
                    local cb=j:FindFirstChild("PalletBreakCommit")
                    if dg then dg:FireServer(nearest) end
                    if cb then cb:FireServer(nearest) end
                end
            end)
            task.wait(0.2)
            local sT=os.clock()
            while c and c.Parent and (c:GetAttribute("Immobile") or c:GetAttribute("immobile")) do
                if os.clock()-sT>3 then break end
                task.wait(0.1)
            end
            IBP=false
        end)
    end
end

-- Auto Break Gen
local IsBG=false
local function AutoBreakGen()
    if not VD.KILLER_AutoBreakGene or GetRole()~="Killer" or IsBG then return end
    local c=LocalPlayer.Character; local r=Root
    if not c or not r then return end
    local im=c:GetAttribute("Immobile") or c:GetAttribute("immobile")
    local cr=c:GetAttribute("IsCarrying") or c:GetAttribute("isCarrying")
    if im or cr then return end
    local pts=CollectionService:GetTagged("GeneratorPoint")
    local nearest,md=nil,6
    for _,p in ipairs(pts) do
        if p:IsA("BasePart") and not CollectionService:HasTag(p,"doing action") then
            local gm=p.Parent
            if gm then
                local pr=gm:GetAttribute("RepairProgress") or 0
                local kc=gm:GetAttribute("kickcount") or 0
                if pr>0 and pr<100 and kc<=7 then
                    local d=(p.Position-r.Position).Magnitude
                    if d<md then md,nearest=d,p end
                end
            end
        end
    end
    if nearest then
        IsBG=true
        task.spawn(function()
            pcall(function()
                local g=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Generator")
                if g then
                    local ev=g:FindFirstChild("BreakGenEvent")
                    local cm=g:FindFirstChild("BreakGenCommit")
                    if ev then ev:FireServer(nearest) end
                    if cm then cm:FireServer(nearest) end
                end
            end)
            task.wait(0.2)
            local sT=os.clock()
            while c and c.Parent and (c:GetAttribute("Immobile") or c:GetAttribute("immobile")) do
                if os.clock()-sT>3 then break end
                task.wait(0.1)
            end
            task.wait(0.3); IsBG=false
        end)
    end
end

-- Block Vaults
local LastVB=0
local function BlockVaults()
    if not VD.KILLER_BlockVaults or GetRole()~="Killer" then return end
    local now=tick(); if now-LastVB<1.5 then return end; LastVB=now
    pcall(function()
        local ve=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Window"):FindFirstChild("VaultEvent")
        if not ve then return end
        local m=Workspace:FindFirstChild("Map")
        local vf=m and m:FindFirstChild("Vaults")
        if vf then for _,v in ipairs(vf:GetChildren()) do
            for _,p in ipairs(v:GetChildren()) do
                if p:IsA("BasePart") then pcall(function() ve:FireServer(p,true) end) end
            end
        end end
    end)
end

-- Block All Pallet Drops
local LastPB=0
local function BlockDrop()
    if not VD.KILLER_BlockPallets or GetRole()~="Killer" then return end
    local now=tick(); if now-LastPB<2 then return end; LastPB=now
    pcall(function()
        local de=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Pallet"):FindFirstChild("PalletDropEvent")
        if not de then return end
        local m=Workspace:FindFirstChild("Map"); if not m then return end
        for _,o in ipairs(m:GetDescendants()) do
            if o.Name=="Palletwrong" and (o:IsA("Model") or o:IsA("Folder")) then
                local t=o:FindFirstChild("PalletPointSlide") or o:FindFirstChild("PalletPoint")
                if t then pcall(function() de:FireServer(t) end) end
            end
        end
    end)
end

-- Break All Pallet
local LastPBD=0; local IsBP=false
local function ForceUnstuck(c)
    pcall(function()
        c:SetAttribute("Immobile",nil); c:SetAttribute("immobile",nil)
        c:SetAttribute("IsStunned",nil); c:SetAttribute("isStunned",nil)
    end)
    pcall(function()
        local h=c:FindFirstChildOfClass("Humanoid")
        if h and h.WalkSpeed<=0 then h.WalkSpeed=16 end
    end)
end
local function BreakAll()
    if not VD.KILLER_BlockPalletDrop or GetRole()~="Killer" or IsBP then return end
    local now=tick(); if now-LastPBD<4 then return end; LastPBD=now
    local c=LocalPlayer.Character; local r=c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end
    local st=c:GetAttribute("IsStunned") or c:GetAttribute("isStunned")
    local im=c:GetAttribute("Immobile") or c:GetAttribute("immobile")
    local cr=c:GetAttribute("IsCarrying") or c:GetAttribute("isCarrying")
    if st or im or cr then return end
    pcall(function()
        local pf=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Pallet")
        local de=pf and pf:FindFirstChild("PalletDropEvent")
        local jf=pf and pf:FindFirstChild("Jason")
        local dg=jf and jf:FindFirstChild("Destroy-Global")
        local bc=jf and jf:FindFirstChild("PalletBreakCommit")
        if not de or not dg or not bc then return end
        local m=Workspace:FindFirstChild("Map"); if not m then return end
        local targets,seen={},{}
        for _,o in ipairs(m:GetDescendants()) do
            if o.Name=="Palletwrong" and (o:IsA("Model") or o:IsA("Folder")) then
                local t=o:FindFirstChild("PalletPointSlide") or o:FindFirstChild("PalletPoint")
                if t and t:IsA("BasePart") and not seen[t] then table.insert(targets,t); seen[t]=true end
            end
        end
        if #targets==0 then return end
        IsBP=true
        task.spawn(function()
            local h=c:FindFirstChildOfClass("Humanoid")
            local oWS=h and h.WalkSpeed or 16
            local oc=r.CFrame
            for _,t in ipairs(targets) do
                if t and t.Parent then pcall(function()
                    de:FireServer(t); task.wait(0.12)
                    r.CFrame=t.CFrame+Vector3.new(0,2,0); task.wait(0.15)
                    dg:FireServer(t); bc:FireServer(t); task.wait(0.12)
                    ForceUnstuck(c)
                end) end
            end
            task.wait(0.1); pcall(function() r.CFrame=oc end); ForceUnstuck(c)
            if h then pcall(function() h.WalkSpeed=oWS end) end
            IsBP=false
        end)
    end)
end

-- Remove Palletwrong
local PWConn, PWScan=false
local function DestroyPW(inst)
    if inst and inst:IsA("Model") and inst.Name=="Palletwrong" then pcall(function() inst:Destroy() end) end
end
local function StartRemovePW()
    if PWConn then return end
    PWConn=Workspace.DescendantAdded:Connect(function(i) if VD.KILLER_NoPalletStun then DestroyPW(i) end end)
    if PWScan then return end; PWScan=true
    task.spawn(function()
        local d=Workspace:GetDescendants()
        for i,inst in ipairs(d) do
            if not VD.KILLER_NoPalletStun then break end
            DestroyPW(inst)
            if i%250==0 then task.wait() end
        end
        PWScan=false
    end)
end
local function StopRemovePW()
    if PWConn then pcall(function() PWConn:Disconnect() end); PWConn=nil end
    PWScan=false
end

-- Anti Blind
local function SetupAntiBlind()
    pcall(function()
        local gb=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Items"):FindFirstChild("Flashlight"):FindFirstChild("GotBlinded")
        if not (gb and gb:IsA("RemoteEvent")) then return end
        local ok,mt=pcall(function() return getrawmetatable(game) end)
        if ok and mt and setreadonly then
            pcall(function()
                setreadonly(mt,false)
                local old=mt.__namecall
                mt.__namecall=newcclosure(function(self,...)
                    if not checkcaller() and VD.KILLER_AntiBlind and self==gb then
                        if getnamecallmethod()=="FireServer" and GetRole()=="Killer" then return nil end
                    end
                    return old(self,...)
                end)
                setreadonly(mt,true)
            end)
        end
    end)
end
SetupAntiBlind()

-- No Slowdown hook
if not getgenv().S404_AntiStunHooked then
    getgenv().S404_AntiStunHooked=true
    pcall(function()
        local ok,mt=pcall(function() return getrawmetatable(game) end)
        if ok and mt and setreadonly then
            pcall(function()
                setreadonly(mt,false)
                local oldNI=mt.__newindex
                mt.__newindex=newcclosure(function(t,k,v)
                    if (k=="WalkSpeed" or k=="Anchored") and not checkcaller() and VD.KILLER_NoSlowdown and GetRole()=="Killer" then
                        if k=="WalkSpeed" and typeof(v)=="number" and v<16 and typeof(t)=="Instance" and t:IsA("Humanoid") then
                            return oldNI(t,k,16)
                        end
                        if k=="Anchored" and v==true and typeof(t)=="Instance" and t:IsA("BasePart") and t.Name=="HumanoidRootPart" then
                            return oldNI(t,k,false)
                        end
                    end
                    return oldNI(t,k,v)
                end)
                setreadonly(mt,true)
            end)
        end
    end)
end

-- Beat Killer
local function BeatKiller()
    if not VD.BEAT_Killer then VD._KTarget=nil; return end
    if GetRole()~="Killer" then VD._KTarget=nil; return end
    local r=Root; if not r then return end
    local t=VD._KTarget; local needNew=true
    if t and t.Character then
        local tr=t.Character:FindFirstChild("HumanoidRootPart")
        local th=t.Character:FindFirstChildOfClass("Humanoid")
        if tr and th and th.MaxHealth>0 and (th.Health/th.MaxHealth)>0.25 then needNew=false
        else VD._KTarget=nil end
    end
    if needNew then
        local sv={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and IsSurvivor(p) and p.Character then
                local pr=p.Character:FindFirstChild("HumanoidRootPart")
                local ph=p.Character:FindFirstChildOfClass("Humanoid")
                if pr and ph and ph.MaxHealth>0 and (ph.Health/ph.MaxHealth)>0.25 then table.insert(sv,p) end
            end
        end
        if #sv>0 then
            local cl,cd=nil,math.huge
            for _,p in ipairs(sv) do
                local pr=p.Character:FindFirstChild("HumanoidRootPart")
                local d=(pr.Position-r.Position).Magnitude
                if d<cd then cd,cl=d,p end
            end
            VD._KTarget=cl; t=cl
        else VD._KTarget=nil; return end
    end
    if not t or not t.Character then return end
    local tr=t.Character:FindFirstChild("HumanoidRootPart")
    local th=t.Character:FindFirstChildOfClass("Humanoid")
    if not tr or not th then VD._KTarget=nil; return end
    if th.MaxHealth<=0 or (th.Health/th.MaxHealth)<=0.25 then VD._KTarget=nil; return end
    for _,p in ipairs(LocalPlayer.Character:GetDescendants()) do
        if p:IsA("BasePart") then pcall(function() p.CanCollide=false end) end
    end
    local dir=(r.Position-tr.Position).Unit
    if dir.Magnitude~=dir.Magnitude then dir=Vector3.new(1,0,0) end
    r.CFrame=CFrame.new(tr.Position+dir*3+Vector3.new(0,1,0),tr.Position)
    pcall(function()
        local ba=ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Attacks") and ReplicatedStorage.Remotes.Attacks:FindFirstChild("BasicAttack")
        if ba then ba:FireServer(false) end
    end)
end

-- =================================================================
-- HIGHLIGHT ESP
-- =================================================================
do
    local LP=LocalPlayer
    local ESPFolder, PlayerConns, MapConns, WorldReg = nil, {}, {}, {Generator={},Hook={},Gate={},Window={},Palletwrong={}}
    local EspId=0; local InstanceIds=setmetatable({},{__mode="k"})
    local PlayerLoop, WorldLoop
    local function GetEP()
        local ok,core=pcall(function() return game:GetService("CoreGui") end)
        if ok and core then return core end
        if gethui then local okH,h=pcall(gethui); if okH and h then return h end end
        return LP:FindFirstChildOfClass("PlayerGui") or Workspace
    end
    local function GetEF()
        if ESPFolder and ESPFolder.Parent then return ESPFolder end
        local p=GetEP()
        local old=p:FindFirstChild("S404_VisualESP"); if old then old:Destroy() end
        local f=Instance.new("Folder"); f.Name="S404_VisualESP"; f.Parent=p; ESPFolder=f; return f
    end
    local function IdF(i)
        if not i then return "nil" end
        local id=InstanceIds[i]; if id then return id end
        EspId=EspId+1; id=tostring(EspId); InstanceIds[i]=id; return id
    end
    local function Vp(p) return p and p.Parent and p:IsA("BasePart") end
    local function RF(p)
        local n=p.Team and p.Team.Name and p.Team.Name:lower() or ""
        if n:find("killer") then return "Killer" end
        if n:find("spect") then return "Spectator" end
        return "Survivor"
    end
    local function RE(p)
        local r=RF(p)
        if r=="Killer" then return VD.ESP_Killer end
        if r=="Spectator" then return VD.ESP_Spectator end
        return VD.ESP_Survivor
    end
    local function CF(p)
        local r=RF(p)
        if r=="Killer" then return VD.ESP_KillerColor end
        if r=="Spectator" then return VD.ESP_SpectatorColor end
        return VD.ESP_SurvivorColor
    end
    local function ClCh(f,n) local c=f:FindFirstChild(n); if c then c:Destroy() end end
    local function ApplyP(p)
        if not p or p==LP then return end
        local k=tostring(p.UserId); local f=GetEF()
        ClCh(f,"S404_PHL_"..k); ClCh(f,"S404_PTag_"..k)
        if not (VD.ESP_PlayerEnabled and RE(p)) then return end
        local c=p.Character; if not c then return end
        local col=CF(p)
        local hl=Instance.new("Highlight")
        hl.Name="S404_PHL_"..k; hl.Adornee=c
        hl.FillColor=col; hl.OutlineColor=col
        hl.FillTransparency=VD.ESP_FillTransparency
        hl.OutlineTransparency=VD.ESP_OutlineTransparency
        hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=f
        if VD.ESP_Nametags or VD.ESP_Distance then
            local head=c:FindFirstChild("Head")
            if head then
                local tag=Instance.new("BillboardGui")
                tag.Name="S404_PTag_"..k; tag.Adornee=head
                tag.AlwaysOnTop,tag.LightInfluence,tag.MaxDistance=true,0,0
                tag.Size=UDim2.new(0,220,0,20); tag.StudsOffset=Vector3.new(0,2.65,0)
                tag.Parent=f
                local l=Instance.new("TextLabel")
                l.Size=UDim2.fromScale(1,1); l.BackgroundTransparency=1
                l.Font=Enum.Font.Gotham; l.TextSize=VD.ESP_TextSize; l.TextColor3=col
                l.TextStrokeTransparency,l.TextStrokeColor3=0.65,Color3.new(0,0,0)
                local parts={}
                if VD.ESP_Nametags then table.insert(parts,p.Name) end
                if VD.ESP_Distance then
                    local mr=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    local tr=c:FindFirstChild("HumanoidRootPart")
                    if mr and tr then table.insert(parts,"["..math.floor((mr.Position-tr.Position).Magnitude).."m]") end
                end
                l.Text=table.concat(parts," "); l.Parent=tag
            end
        end
    end
    local function ClP(p)
        if not p or p==LP then return end
        local k=tostring(p.UserId); local f=GetEF()
        ClCh(f,"S404_PHL_"..k); ClCh(f,"S404_PTag_"..k)
    end
    local function ClAllP() for _,p in ipairs(Players:GetPlayers()) do if p~=LP then ClP(p) end end end
    local function RefAllP() for _,p in ipairs(Players:GetPlayers()) do if p~=LP then pcall(ApplyP,p) end end end
    local function StartPLoop()
        if PlayerLoop then return end
        PlayerLoop=task.spawn(function()
            while not VD.Destroyed and VD.ESP_PlayerEnabled do RefAllP(); task.wait(0.25) end
            PlayerLoop=nil
        end)
    end
    local function WatchP(p)
        if p==LP then return end
        if PlayerConns[p] then for _,c in ipairs(PlayerConns[p]) do pcall(function() c:Disconnect() end) end end
        PlayerConns[p]={}
        table.insert(PlayerConns[p], p.CharacterAdded:Connect(function()
            ClP(p); task.delay(0.15,function() if not VD.Destroyed then pcall(ApplyP,p) end end)
        end))
        table.insert(PlayerConns[p], p.CharacterRemoving:Connect(function() ClP(p) end))
        table.insert(PlayerConns[p], p:GetPropertyChangedSignal("Team"):Connect(function() ClP(p); pcall(ApplyP,p) end))
        if p.Character then pcall(ApplyP,p) end
    end
    local function UnwatchP(p)
        ClP(p)
        if PlayerConns[p] then for _,c in ipairs(PlayerConns[p]) do pcall(function() c:Disconnect() end) end end
        PlayerConns[p]=nil
    end
    local VCat={Generator=true,Hook=true,Gate=true,Window=true,Palletwrong=true}
    local function PickWP(m,cat)
        if not (m and m.Parent) then return nil end
        if cat=="Generator" then return m:FindFirstChild("HitBox",true) or m:FindFirstChild("GeneratorPoint",true) end
        if cat=="Palletwrong" then
            for _,n in ipairs({"HumanoidRootPart","PalletPoint","PalletPointSlide"}) do
                local p=m:FindFirstChild(n,true); if Vp(p) then return p end
            end
        end
        if cat=="Window" then return m:FindFirstChild("VaultPoint",true) or m:FindFirstChild("VaultTrigger",true) end
        if m:IsA("BasePart") then return m end
        return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart",true)
    end
    local function WK(cat,m) return "S404_W_"..cat.."_"..IdF(m) end
    local function ClW(cat,m)
        local f=GetEF(); ClCh(f,WK(cat,m).."_HL")
    end
    local function RemW(cat,m)
        if not WorldReg[cat][m] then return end
        ClW(cat,m); WorldReg[cat][m]=nil
    end
    local function EnsW(cat,m)
        if not (m and m.Parent) or WorldReg[cat][m] then return end
        local p=PickWP(m,cat); if not Vp(p) then return end
        WorldReg[cat][m]={part=p}
    end
    local function RegD(o)
        if not o then return end
        if o:IsA("Model") and VCat[o.Name] then EnsW(o.Name,o); return end
        if o:IsA("BasePart") then
            local p=o.Parent
            while p and p~=Workspace do
                if p:IsA("Model") and VCat[p.Name] then EnsW(p.Name,p); return end
                p=p.Parent
            end
        end
    end
    local function UnregD(o)
        if not o then return end
        if o:IsA("Model") and VCat[o.Name] then RemW(o.Name,o); return end
        if o:IsA("BasePart") then
            for cat,ms in pairs(WorldReg) do
                for m,e in pairs(ms) do if e.part==o then RemW(cat,m) end end
            end
        end
    end
    local function AttachR(r)
        if MapConns[r] then return end
        MapConns[r]={add=r.DescendantAdded:Connect(RegD), rem=r.DescendantRemoving:Connect(UnregD)}
        for _,d in ipairs(r:GetDescendants()) do RegD(d) end
    end
    local function RefRoots()
        for _,c in pairs(MapConns) do
            pcall(function() c.add:Disconnect() end); pcall(function() c.rem:Disconnect() end)
        end
        MapConns={}
        for cat,ms in pairs(WorldReg) do
            for m in pairs(ms) do ClW(cat,m) end
            WorldReg[cat]={}
        end
        local m1=Workspace:FindFirstChild("Map"); local m2=Workspace:FindFirstChild("Map1")
        if m1 then AttachR(m1) end
        if m2 then AttachR(m2) end
    end
    local function CatD(cat)
        if cat=="Generator" then return VD.ESP_Generator,VD.ESP_GeneratorColor end
        if cat=="Hook" then return VD.ESP_Hook,VD.ESP_HookColor end
        if cat=="Gate" then return VD.ESP_Gate,VD.ESP_GateColor end
        if cat=="Window" then return VD.ESP_Window,VD.ESP_WindowColor end
        if cat=="Palletwrong" then return VD.ESP_Pallet,VD.ESP_PalletColor end
        return false,Color3.new(1,1,1)
    end
    local function AnyW()
        return VD.ESP_WorldEnabled and (VD.ESP_Generator or VD.ESP_Hook or VD.ESP_Gate or VD.ESP_Window or VD.ESP_Pallet)
    end
    local function ClAllW()
        for cat,ms in pairs(WorldReg) do for m in pairs(ms) do ClW(cat,m) end end
    end
    local function StartWL()
        if WorldLoop then return end
        WorldLoop=task.spawn(function()
            while not VD.Destroyed and AnyW() do
                local f=GetEF()
                for cat,ms in pairs(WorldReg) do
                    local en,col=CatD(cat)
                    if en and VD.ESP_WorldEnabled then
                        local n=0
                        for m,e in pairs(ms) do
                            if m and m.Parent then
                                local p=e.part
                                if not Vp(p) or not p:IsDescendantOf(m) then e.part=PickWP(m,cat); p=e.part end
                                if Vp(p) then
                                    local k=WK(cat,m)
                                    ClCh(f,k.."_HL")
                                    local hl=Instance.new("Highlight")
                                    hl.Name=k.."_HL"; hl.Adornee=m
                                    hl.FillColor,hl.OutlineColor=col,col
                                    hl.FillTransparency,hl.OutlineTransparency=0.98,0.5
                                    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=f
                                else RemW(cat,m) end
                            else RemW(cat,m) end
                            n=n+1
                            if n%60==0 then task.wait() end
                        end
                    else
                        for m in pairs(ms) do ClW(cat,m) end
                    end
                end
                task.wait(0.25)
            end
            WorldLoop=nil
        end)
    end
    getgenv().S404_RefAllP=RefAllP
    getgenv().S404_ClAllP=ClAllP
    getgenv().S404_ClAllW=ClAllW
    getgenv().S404_StartPLoop=StartPLoop
    getgenv().S404_StartWL=StartWL
    getgenv().S404_RefRoots=RefRoots
    for _,p in ipairs(Players:GetPlayers()) do WatchP(p) end
    Players.PlayerAdded:Connect(WatchP)
    Players.PlayerRemoving:Connect(UnwatchP)
    Workspace.ChildAdded:Connect(function(c)
        if c.Name=="Map" or c.Name=="Map1" then
            AttachR(c); if AnyW() then StartWL() end
        end
    end)
    Workspace.ChildRemoved:Connect(function(c)
        if c.Name=="Map" or c.Name=="Map1" then RefRoots() end
    end)
    RefRoots()
end

-- =================================================================
-- NO CUTSCENE + CAMERA
-- =================================================================
local fb, fr = Instance.new("BindableEvent"), Instance.new("RemoteEvent")
pcall(function()
    local ok,mt=pcall(function() return getrawmetatable(game) end)
    if ok and mt and setreadonly then
        pcall(function()
            setreadonly(mt,false)
            local oi=mt.__index
            mt.__index=newcclosure(function(t,k)
                if (k=="OnClientEvent" or k=="Event") and VD.NoCutscene and not checkcaller() and typeof(t)=="Instance" then
                    local n=t.Name
                    if n=="cutscene" and k=="Event" and t.Parent and t.Parent.Name=="Game" then return fb.Event end
                    if (n=="cutsceneEnd" or n=="cutsceneEnd2" or n=="cutsceneEndwithownchar" or n=="endscreencutscene") and t.Parent and t.Parent.Name=="Game" then return fr.OnClientEvent end
                end
                return oi(t,k)
            end)
            setreadonly(mt,true)
        end)
    end
end)
task.spawn(function()
    local gf=ReplicatedStorage:WaitForChild("Remotes",10):WaitForChild("Game",10)
    if not gf then return end
    local function show()
        if not VD.NoCutscene then return end
        pcall(function()
            local cam=workspace.CurrentCamera
            if cam then cam.CameraType=Enum.CameraType.Custom; cam.FieldOfView=70 end
            UserInputService.MouseIconEnabled=true
            pcall(function() game:GetService("SoundService"):WaitForChild("chase").Volume=0 end)
            LocalPlayer:SetAttribute("isspectating",true)
            local pg=LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                local R=pg:FindFirstChild("Results"); local E=pg:FindFirstChild("EndScreen"); local D=pg:FindFirstChild("Darkness")
                if R then R.Enabled=true end
                if E then E.Enabled=true; local b=E:FindFirstChild("blackout"); if b then b.BackgroundTransparency=1 end end
                if D then D.Enabled=true; local f2=D:FindFirstChild("Frame2"); if f2 then f2.BackgroundTransparency=1 end end
            end
        end)
    end
    for _,n in ipairs({"endscreencutscene","cutsceneEnd","cutsceneEnd2","cutsceneEndwithownchar"}) do
        local ev=gf:WaitForChild(n,10)
        if ev then ev.OnClientEvent:Connect(show) end
    end
end)

local OF, OT, OO, FA, TPA, SLA = nil,nil,nil,false,false,false
local function UpdFOV()
    local cam=workspace.CurrentCamera; if not cam then return end
    if VD.CAM_FOVEnabled then
        if not FA then OF=cam.FieldOfView; FA=true end
        cam.FieldOfView=VD.CAM_FOV or 90
    elseif FA then
        if OF then cam.FieldOfView=OF end
        OF,FA=nil,false
    end
end
local function UpdTP()
    local cam=workspace.CurrentCamera; if not cam then return end
    local s=VD.CAM_ThirdPerson and GetRole()=="Killer"
    if s then
        if not TPA then
            OT=cam.CameraType
            local c=LocalPlayer.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
            OO=h and h.CameraOffset or Vector3.new(0,0,0)
        end
        cam.CameraType=Enum.CameraType.Custom
        local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.CameraOffset=Vector3.new(2,1,8) end
        TPA=true
    elseif TPA then
        if OT then cam.CameraType=OT; OT=nil end
        local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.CameraOffset=OO or Vector3.new(0,0,0) end
        OO,TPA=nil,false
    end
end
local function UpdSL()
    local c=LocalPlayer.Character; local h=c and c:FindFirstChildOfClass("Humanoid")
    local r=c and c:FindFirstChild("HumanoidRootPart"); local cam=workspace.CurrentCamera
    if VD.CAM_ShiftLock then
        if not c or not r or not cam then return end
        if h then h.AutoRotate=false end
        SLA=true
        local fl=Vector3.new(cam.CFrame.LookVector.X,0,cam.CFrame.LookVector.Z)
        if fl.Magnitude>0.001 then r.CFrame=CFrame.new(r.Position,r.Position+fl.Unit) end
    elseif SLA then
        if h then h.AutoRotate=true end
        SLA=false
    end
end
RunService.RenderStepped:Connect(function()
    if VD.Destroyed then return end
    pcall(VD_UpdateWeatherAnchor); pcall(UpdFOV); pcall(UpdTP); pcall(UpdSL)
end)

-- Main Auto Loop
task.spawn(function()
    while not VD.Destroyed do
        pcall(AutoAttack); pcall(UpdHB); pcall(DestroyPallets)
        pcall(AutoBreakGen); pcall(BlockVaults); pcall(BlockDrop); pcall(BreakAll)
        pcall(BeatKiller); pcall(AutoHook); pcall(UpdLunge)
        if VD.KILLER_NoPalletStun then pcall(StartRemovePW) else pcall(StopRemovePW) end
        task.wait(0.15)
    end
end)
task.spawn(function()
    while not VD.Destroyed do pcall(ScanMap); task.wait(5) end
end)

