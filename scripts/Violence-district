local VD = getgenv().VD

local function updateChar(c)
    Character = c or LocalPlayer.Character
    if Character then
        task.spawn(function()
            Humanoid = Character:WaitForChild("Humanoid", 5)
            Root = Character:WaitForChild("HumanoidRootPart", 5)
        end)
    else Humanoid, Root = nil, nil end
end
updateChar()
LocalPlayer.CharacterAdded:Connect(updateChar)
LocalPlayer.CharacterRemoving:Connect(function(c)
    if c == Character then Character, Humanoid, Root = nil, nil, nil end
end)

local function GetRole()
    if not LocalPlayer.Team then return "Unknown" end
    local n = LocalPlayer.Team.Name
    if n == "Killer" then return "Killer" end
    if n == "Survivors" then return "Survivor" end
    return "Lobby"
end
local function IsKiller(p) return p and p.Team and p.Team.Name == "Killer" end
local function IsSurvivor(p) return p and p.Team and p.Team.Name == "Survivors" end
local function IsDowned(c)
    if not c then return true end
    local s = c:GetAttribute("State")
    return s == "Downed" or s == "Dead"
end
local function GetSafeGuiParent()
    if gethui then return gethui() end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return LocalPlayer:FindFirstChild("PlayerGui")
end

