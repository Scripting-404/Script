local VD_CurSky, VD_WeatherCC, VD_WeatherATM, VD_ParticleAnchor

local function VD_UpdateWeatherAnchor()
    local a = VD_ParticleAnchor
    if not a then return end
    if a.Parent ~= workspace then pcall(function() a.Parent = workspace end) end
    local cam = workspace.CurrentCamera; if not cam then return end
    local ox = a:GetAttribute("VD_OX") or 0
    local oy = a:GetAttribute("VD_OY") or 30
    local oz = a:GetAttribute("VD_OZ") or 0
    a.CFrame = CFrame.new(cam.CFrame.Position + cam.CFrame.RightVector*ox + Vector3.new(0,oy,0) + cam.CFrame.LookVector*math.abs(oz))
end

local function VD_ApplyWeather(name)
    local theme = KYS_WeatherPresets[name] or KYS_WeatherPresets["Default"]
    if VD_CurSky and VD_CurSky.Parent then VD_CurSky:Destroy() end; VD_CurSky = nil
    if VD_WeatherCC and VD_WeatherCC.Parent then VD_WeatherCC:Destroy() end; VD_WeatherCC = nil
    if VD_WeatherATM and VD_WeatherATM.Parent then VD_WeatherATM:Destroy() end; VD_WeatherATM = nil
    if theme.Atmosphere then
        local atm = Instance.new("Atmosphere"); atm.Name = "VD_WeatherAtmosphere"
        for k,v in pairs(theme.Atmosphere) do pcall(function() atm[k]=v end) end
        atm.Parent = Lighting; VD_WeatherATM = atm
    end
    if theme.CC then
        local cc = Instance.new("ColorCorrectionEffect"); cc.Name = "VD_WeatherCC"
        for k,v in pairs(theme.CC) do pcall(function() cc[k]=v end) end
        cc.Parent = Lighting; VD_WeatherCC = cc
    end
    if theme.Lighting then
        for k,v in pairs(theme.Lighting) do pcall(function() Lighting[k]=v end) end
    elseif not VD.Fullbright and not VD.NO_Fog then
        Lighting.Brightness=originalLighting.Brightness
        Lighting.ClockTime=originalLighting.ClockTime
        Lighting.FogEnd=originalLighting.FogEnd
        Lighting.OutdoorAmbient=originalLighting.OutdoorAmbient
    end
    if VD.Fullbright then Lighting.Brightness=math.max(Lighting.Brightness,2); Lighting.GlobalShadows=false end
    if VD.NO_Fog then Lighting.FogStart=0; Lighting.FogEnd=100000 end
    if VD_ParticleAnchor and VD_ParticleAnchor.Parent then VD_ParticleAnchor:Destroy() end
    VD_ParticleAnchor = nil
    if theme.Particle then
        local anchor = Instance.new("Part")
        anchor.Name="VD_WeatherAnchor"; anchor.Transparency=0.99
        anchor.CanCollide,anchor.Anchored=false,true
        anchor.Size = theme.Particle.AnchorSize or Vector3.new(120,1,120)
        anchor:SetAttribute("VD_OX", theme.Particle.CameraOffset and theme.Particle.CameraOffset.X or 0)
        anchor:SetAttribute("VD_OY", theme.Particle.CameraOffset and theme.Particle.CameraOffset.Y or 30)
        anchor:SetAttribute("VD_OZ", theme.Particle.CameraOffset and theme.Particle.CameraOffset.Z or 0)
        local pe = Instance.new("ParticleEmitter")
        pe.Name,pe.Enabled,pe.EmissionDirection="VD_WeatherEmitter",true,Enum.NormalId.Bottom
        pe.LockedToPart,pe.ZOffset,pe.LightEmission=false,2,0.25
        pe.SpreadAngle=Vector2.new(10,10)
        pcall(function() pe.Shape=Enum.ParticleEmitterShape.Box end)
        pcall(function() pe.ShapeStyle=Enum.ParticleEmitterShapeStyle.Volume end)
        for k,v in pairs(theme.Particle) do
            if k~="AnchorSize" and k~="CameraOffset" then pcall(function() pe[k]=v end) end
        end
        pe.Parent=anchor; anchor.Parent=workspace
        VD_ParticleAnchor=anchor
        pcall(VD_UpdateWeatherAnchor)
    end
end

task.spawn(function()
    while not VD.Destroyed do
        if VD.Fullbright then
            local th = VD.VIS_WeatherTheme and KYS_WeatherPresets[VD.VIS_WeatherTheme]
            local keep = VD.VIS_WeatherTheme and VD.VIS_WeatherTheme~="Default" and th and th.Lighting
            if keep then
                for k,v in pairs(th.Lighting) do pcall(function() Lighting[k]=v end) end
                Lighting.Brightness=math.max(Lighting.Brightness,2); Lighting.GlobalShadows=false
                if VD.NO_Fog then Lighting.FogStart=0; Lighting.FogEnd=100000 end
            else
                Lighting.Brightness,Lighting.ClockTime,Lighting.GlobalShadows=2,14,false
                Lighting.OutdoorAmbient,Lighting.FogStart,Lighting.FogEnd=Color3.fromRGB(128,128,128),0,100000
            end
            for _,v in pairs(Lighting:GetChildren()) do
                if v:IsA("Atmosphere") and v.Name~="VD_WeatherAtmosphere" then v.Density=0;v.Offset=0;v.Glare=0;v.Haze=0 end
                if v:IsA("BlurEffect") then v.Size=0 end
                if v:IsA("ColorCorrectionEffect") and v.Name~="VD_WeatherCC" then v.Enabled=false end
                if v:IsA("SunRaysEffect") then v.Enabled=false end
            end
        else
            local th = VD.VIS_WeatherTheme and KYS_WeatherPresets[VD.VIS_WeatherTheme]
            if VD.VIS_WeatherTheme and VD.VIS_WeatherTheme~="Default" and th and th.Lighting then
                for k,v in pairs(th.Lighting) do pcall(function() Lighting[k]=v end) end
            else
                Lighting.Brightness,Lighting.ClockTime=originalLighting.Brightness,originalLighting.ClockTime
                Lighting.FogEnd,Lighting.FogStart=originalLighting.FogEnd,originalLighting.FogStart or 0
                Lighting.GlobalShadows,Lighting.OutdoorAmbient=originalLighting.GlobalShadows,originalLighting.OutdoorAmbient
            end
        end
        task.wait(0.5)
    end
end)

-- =================================================================
-- CROSSHAIR
