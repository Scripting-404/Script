local CrosshairGui
local function VD_UpdateCrosshair()
    if CrosshairGui then pcall(function() CrosshairGui:Destroy() end); CrosshairGui=nil end
    if not VD.CROSS_Enabled then return end
    local parent = GetSafeGuiParent(); if not parent then return end
    CrosshairGui = Instance.new("ScreenGui")
    CrosshairGui.Name="S404_Crosshair"; CrosshairGui.DisplayOrder=999999; CrosshairGui.IgnoreGuiInset=true
    CrosshairGui.Parent=parent
    local center=Instance.new("Frame"); center.BackgroundTransparency=1
    center.Position=UDim2.new(0.5,VD.CROSS_PosX,0.5,VD.CROSS_PosY); center.Size=UDim2.new(0,0,0,0); center.Parent=CrosshairGui
    local color=VD.CROSS_Color or Color3.fromRGB(90,90,90)
    local size,gap,thick,style=VD.CROSS_Size or 3,VD.CROSS_Gap or 6,VD.CROSS_Thickness or 4,VD.CROSS_Style or "Dot"
    if style=="Dot" then
        local d=Instance.new("Frame"); d.AnchorPoint=Vector2.new(0.5,0.5)
        d.Size=UDim2.new(0,size*2,0,size*2); d.BackgroundColor3=color; d.BorderSizePixel=0
        d.Parent=center; local c=Instance.new("UICorner",d); c.CornerRadius=UDim.new(1,0)
    elseif style=="Plus" or style=="X" then
        local len=size*3
        for i=1,4 do
            local l=Instance.new("Frame"); l.AnchorPoint=Vector2.new(0.5,0.5)
            l.BackgroundColor3=color; l.BorderSizePixel=0
            local ang=(i-1)*90; if style=="X" then ang=ang+45 end
            l.Rotation=ang; l.Size=UDim2.new(0,len,0,thick)
            local rad,dist=math.rad(ang),gap+len/2
            l.Position=UDim2.new(0,math.floor(math.cos(rad)*dist+0.5),0,math.floor(math.sin(rad)*dist+0.5))
            l.Parent=center
        end
    elseif style=="Box" then
        local h=gap+size*2
        local function edge(px,py,sx,sy)
            local e=Instance.new("Frame"); e.AnchorPoint=Vector2.new(0.5,0.5)
            e.BackgroundColor3=color; e.BorderSizePixel=0
            e.Size=UDim2.new(0,sx,0,sy); e.Position=UDim2.new(0,px,0,py); e.Parent=center
        end
        edge(0,-h,h*2+thick,thick); edge(0,h,h*2+thick,thick)
        edge(-h,0,thick,h*2-thick); edge(h,0,thick,h*2-thick)
    end
end

RunService.RenderStepped:Connect(function()
    if not VD.HideSkillUI then return end
    local pg=LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return end
    local a,b=pg:FindFirstChild("SkillCheckPromptGui"),pg:FindFirstChild("SkillCheckPromptGui-con")
    if a and a.Enabled then a.Enabled=false end
    if b and b.Enabled then b.Enabled=false end
end)

-- =================================================================
-- AUTO SKILLCHECK
-- =================================================================
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local AS = { WasActive=false, HasClicked=false, PerfectWas=false, PerfectClicked=false, InstantClicked=false }

local function PressSkill()
    if isMobile then
        local btn=PlayerGui:FindFirstChild("check",true)
        if btn and btn:IsA("GuiObject") then
            local pos,sz=btn.AbsolutePosition,btn.AbsoluteSize
            local inset=GuiService:GetGuiInset()
            local x,y=pos.X+sz.X/2+inset.X, pos.Y+sz.Y/2+inset.Y
            pcall(function() VirtualInputManager:SendTouchEvent(8822,Enum.UserInputState.Begin.Value,x,y) end)
            task.wait(0.01)
            pcall(function() VirtualInputManager:SendTouchEvent(8822,Enum.UserInputState.End.Value,x,y) end)
            pcall(function() if firesignal and btn.MouseButton1Click then firesignal(btn.MouseButton1Click) end end)
        end
    else
        pcall(function() VirtualInputManager:SendKeyEvent(true,Enum.KeyCode.Space,false,game) end)
        task.wait(0.01)
        pcall(function() VirtualInputManager:SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
    end
end

local function GetSkillCheck()
    for _,n in ipairs({"SkillCheckPromptGui","SkillCheckPromptGui-con"}) do
        local gui=PlayerGui:FindFirstChild(n,true)
        if gui then
            local chk=gui:FindFirstChild("Check",true)
            if chk and chk.Visible then
                local l,g=chk:FindFirstChild("Line",true),chk:FindFirstChild("Goal",true)
                if l and g then return l,g end
            end
        end
    end
end

local function AngDelta(f,t) local d=t-f; if d>180 then d=d-360 end; if d<-180 then d=d+360 end; return d end
local function CrossedZone(prev,cur,sp,ep)
    local function inz(r) if sp>ep then return r>=sp or r<=ep end; return r>=sp and r<=ep end
    if inz(cur) then return true end
    if prev==nil then return false end
    local d=AngDelta(prev,cur); local st=math.abs(math.floor(d))
    if st<2 then return false end
    local s=d/st
    for i=1,st do if inz((prev+s*i)%360) then return true end end
    return false
end

local function NormalSkill()
    local l,g=GetSkillCheck()
    if not (l and g) then AS.WasActive=false; AS.HasClicked=false; return end
    local lr,gr,now=l.Rotation%360,g.Rotation%360,os.clock()
    if not AS.WasActive then
        AS.WasActive=true; AS.HasClicked=false
        AS.LastGoal=gr; AS.LastLine=lr; AS.LastTick=now; return
    end
    if AS.LastGoal and math.abs(AngDelta(AS.LastGoal,gr))>5 then
        AS.HasClicked=false; AS.LastLine=nil; AS.LastTick=nil
    end
    AS.LastGoal=gr
    if AS.HasClicked then AS.LastLine=lr; AS.LastTick=now; return end
    if AS.LastLine and AS.LastTick then
        local dt=now-AS.LastTick
        if dt>0 then
            local spd=AngDelta(AS.LastLine,lr)/dt
            local pred=(lr+spd*dt*0)%360
            if CrossedZone(AS.LastLine,pred,(gr+104)%360,(gr+109)%360) then
                AS.HasClicked=true
                task.spawn(function() task.wait(0.03); PressSkill() end)
            end
        end
    end
    AS.LastLine=lr; AS.LastTick=now
end

local function PerfectSkill()
    local l,g=GetSkillCheck()
    if not (l and g) then AS.PerfectWas=false; AS.PerfectClicked=false; return end
    local lr,gr,now=l.Rotation%360,g.Rotation%360,os.clock()
    if not AS.PerfectWas then
        AS.PerfectWas=true; AS.PerfectClicked=false
        AS.PLG=gr; AS.PLL=lr; AS.PLT=now; return
    end
    if AS.PLG and math.abs(AngDelta(AS.PLG,gr))>5 then
        AS.PerfectClicked=false; AS.PLL=nil; AS.PLT=nil
    end
    AS.PLG=gr
    if AS.PerfectClicked then AS.PLL=lr; AS.PLT=now; return end
    if AS.PLL and AS.PLT then
        local dt=now-AS.PLT
        if dt>0 then
            local spd=AngDelta(AS.PLL,lr)/dt
            local pred=(lr+spd*dt*0)%360
            if CrossedZone(AS.PLL,pred,(gr+104)%360,(gr+108)%360) then
                AS.PerfectClicked=true; PressSkill()
            end
        end
    end
    AS.PLL=lr; AS.PLT=now
end

local function InstantSkill()
    if AS.InstantClicked then return end
    local p=PlayerGui:FindFirstChild("SkillCheckPromptGui") or PlayerGui:FindFirstChild("SkillCheckPromptGui-con")
    if not p then return end
    local chk=p:FindFirstChild("Check")
    if not chk or not chk.Visible then return end
    local l,g=chk:FindFirstChild("Line"),chk:FindFirstChild("Goal")
    if not l or not g then return end
    l.Rotation=g.Rotation+109
    AS.InstantClicked=true
    task.spawn(function() PressSkill(); task.wait(0.2); AS.InstantClicked=false end)
end

RunService.RenderStepped:Connect(function()
    if not VD.AutoSkillcheck then return end
    if VD.AutoSkillcheckMode=="Perfect" then PerfectSkill()
    elseif VD.AutoSkillcheckMode=="Instant" then InstantSkill()
    else NormalSkill() end
end)

-- =================================================================
-- AUTO PARRY
-- =================================================================
local ParryRange = Instance.new("CylinderHandleAdornment")
ParryRange.Name="S404_ParryRange"; ParryRange.Radius=8; ParryRange.InnerRadius=7.85
ParryRange.Height=0.01; ParryRange.Color3=Color3.fromRGB(150,150,150)
ParryRange.Adornee=Workspace:FindFirstChildOfClass("Terrain")
ParryRange.Transparency=1; ParryRange.Parent=GetSafeGuiParent()

local ATTACK_ANIMS={}
for _,id in ipairs({
    "rbxassetid://113255068724446","rbxassetid://74968262036854","rbxassetid://110355011987939",
    "rbxassetid://139369275981139","rbxassetid://132817836308238","rbxassetid://129784271201071",
    "rbxassetid://133963973694098","rbxassetid://117042998468241","rbxassetid://105374834496520",
    "rbxassetid://111920872708571","rbxassetid://78432063483146","rbxassetid://118907603246885",
    "rbxassetid://138720291317243","rbxassetid://115244153053858","rbxassetid://130593238885843",
    "rbxassetid://122812055447896","rbxassetid://78935059863801","rbxassetid://135002183282873",
    "rbxassetid://121216847022485"
}) do ATTACK_ANIMS[id]=true end

local function UpdateParryRange()
    if not VD.SURV_ShowParryCircle or not VD.SURV_AutoParry then ParryRange.Transparency=1; return end
    local c=LocalPlayer.Character; local r=c and c:FindFirstChild("HumanoidRootPart")
    if not r then ParryRange.Transparency=1; return end
    local md=VD.SURV_ParryDistance or 8
    ParryRange.Transparency=0.4; ParryRange.Radius=md; ParryRange.InnerRadius=math.max(0.1,md-0.15)
    local params=RaycastParams.new()
    params.FilterDescendantsInstances={c}; params.FilterType=Enum.RaycastFilterType.Exclude
    local ray=Workspace:Raycast(r.Position,Vector3.new(0,-15,0),params)
    local gp=ray and ray.Position or (r.Position-Vector3.new(0,3,0))
    ParryRange.CFrame=CFrame.new(gp+Vector3.new(0,0.05,0))*CFrame.Angles(math.pi/2,0,0)
end

local ParryState={Cooldown=false, Thread=nil}
local ParryAtt={}

local function TriggerCrouch()
    local st=tick()
    task.spawn(function()
        local c=LocalPlayer.Character; if not c then return end
        local h=c:FindFirstChildOfClass("Humanoid")
        pcall(function() c:SetAttribute("Crouching",true) end)
        pcall(function() ReplicatedStorage.Remotes.Mechanics.ChangeAttribute:FireServer("Crouchingserver",true) end)
        pcall(function() ReplicatedStorage.Remotes.Chase.Runevent:FireServer(c,false) end)
        if h then pcall(function() h:ChangeState(Enum.HumanoidStateType.Landed) end) end
        while tick()-st<1.2 do
            pcall(function() ReplicatedStorage.Remotes.Mechanics.ChangeAttribute:FireServer("Crouchingserver",true) end)
            task.wait(0.1)
        end
        pcall(function() c:SetAttribute("Crouching",false) end)
        pcall(function() ReplicatedStorage.Remotes.Mechanics.ChangeAttribute:FireServer("Crouchingserver",false) end)
        if h then pcall(function() h:ChangeState(Enum.HumanoidStateType.Landed) end) end
    end)
end

local function TapMobileParry()
    local pg=LocalPlayer:FindFirstChild("PlayerGui"); if not pg then return end
    local sm=pg:FindFirstChild("Survivor-mob")
    local pb=sm and sm:FindFirstChild("Controls") and sm.Controls:FindFirstChild("Gui-mob")
    if pb and pb.Visible then
        if firesignal then pcall(function() firesignal(pb.MouseButton1Down); task.wait(0.01); firesignal(pb.MouseButton1Up) end) end
    else
        pcall(function()
            if mouse2click then mouse2click(); return end
            if mouse2press and mouse2release then mouse2press(); task.wait(0.01); mouse2release(); return end
            if MouseButton2Click then MouseButton2Click(); return end
            VirtualInputManager:SendMouseButtonEvent(0,0,1,true,game,0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(0,0,1,false,game,0)
        end)
    end
end

local function ExecuteParry()
    if ParryState.Cooldown then return end
    pcall(function()
        local pr=ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("Items"):FindFirstChild("Parrying Dagger"):FindFirstChild("parry")
        if pr then for _=1,10 do pr:FireServer() end end
        task.spawn(TapMobileParry)
    end)
end

task.spawn(function()
    local r=ReplicatedStorage:WaitForChild("Remotes",5)
    local d=r and r:WaitForChild("Items",5):WaitForChild("Parrying Dagger",5)
    local res=d and d:WaitForChild("parryResult",5)
    if res then res.OnClientEvent:Connect(function(a1,a2)
        local cd=tonumber(a2) or ((a1==true) and 90 or 60)
        ParryState.Cooldown=true
        if ParryState.Thread then task.cancel(ParryState.Thread) end
        ParryState.Thread=task.delay(cd,function() ParryState.Cooldown=false end)
    end) end
end)

local function AttachParry(kChar)
    if not kChar or ParryAtt[kChar] then return end
    ParryAtt[kChar]=true
    local h=kChar:FindFirstChild("Humanoid") or kChar:WaitForChild("Humanoid",5)
    if not h then return end
    local an=h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator",5)
    if not an then return end
    h.ChildAdded:Connect(function(c) if c:IsA("Animator") then ParryAtt[kChar]=nil; AttachParry(kChar) end end)
    kChar.AncestryChanged:Connect(function(_,p) if not p then ParryAtt[kChar]=nil end end)
    an.AnimationPlayed:Connect(function(track)
        local id=(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if id=="80411309607666" and VD.AutoCrouch then
            local mc=LocalPlayer.Character; if IsDowned(mc) then return end
            local mR=mc and mc:FindFirstChild("HumanoidRootPart")
            local kR=kChar:FindFirstChild("HumanoidRootPart")
            if mR and kR and (mR.Position-kR.Position).Magnitude<=40 then TriggerCrouch() end
            return
        end
        if not ATTACK_ANIMS[id] then return end
        if not VD.SURV_AutoParry or ParryState.Cooldown then return end
        local mc=LocalPlayer.Character; if IsDowned(mc) then return end
        local mR=mc and mc:FindFirstChild("HumanoidRootPart")
        local kR=kChar:FindFirstChild("HumanoidRootPart")
        if not mR or not kR then return end
        local dist=(mR.Position-kR.Position).Magnitude
        if VD.SURV_ParryAggressive then
            local aggr,det=12,VD.SURV_ParryDistance+5
            if dist>det then return end
            if dist<=aggr then ExecuteParry() else
                local st=os.clock(); local tr
                tr=RunService.Heartbeat:Connect(function()
                    if os.clock()-st>=1.5 or ParryState.Cooldown or not mR or not kR or IsDowned(mc) then
                        if tr then tr:Disconnect() end; return
                    end
                    if (mR.Position-kR.Position).Magnitude<=aggr then
                        ExecuteParry(); if tr then tr:Disconnect() end
                    end
                end)
            end
        else
            if dist>VD.SURV_ParryDistance then return end
            local mF=Vector3.new(mR.Position.X,0,mR.Position.Z)
            local kF=Vector3.new(kR.Position.X,0,kR.Position.Z)
            local dl=mF-kF
            if dl.Magnitude>0 then
                local kl=Vector3.new(kR.CFrame.LookVector.X,0,kR.CFrame.LookVector.Z).Unit
                if kl:Dot(dl.Unit)<0.6 then return end
            end
            ExecuteParry()
        end
    end)
end

local function TryAttach(p)
    if p~=LocalPlayer and IsKiller(p) and p.Character then AttachParry(p.Character) end
end
local function SetupPP(p)
    if p==LocalPlayer then return end
    p.CharacterAdded:Connect(function() TryAttach(p) end)
    p:GetPropertyChangedSignal("Team"):Connect(function() TryAttach(p) end)
    if p.Character then TryAttach(p) end
end
for _,p in ipairs(Players:GetPlayers()) do SetupPP(p) end
Players.PlayerAdded:Connect(SetupPP)
task.spawn(function()
    while not VD.Destroyed do task.wait(5); for _,p in ipairs(Players:GetPlayers()) do TryAttach(p) end end
end)
task.spawn(function()
    while not VD.Destroyed do pcall(UpdateParryRange); task.wait(0.1) end
end)

